# MES Dashboard Environment Configuration
# Copy this file to .env.development or .env.production and update values

# Backend API URL
VITE_API_URL=http://localhost:3000

# WebSocket URL (usually same as API URL)
VITE_WS_URL=http://localhost:3000

# Google OAuth Client ID (for Google Sign-In)
# Get this from Google Cloud Console: https://console.cloud.google.com/
# See "MES Dashboard/Google SSO Setup Guide.md" for instructions
VITE_GOOGLE_CLIENT_ID=
